# Variáveis para o docker-compose (copie para .env e ajuste)

# ── Banco de dados ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=pelada_adm

# ── Backend ──
# Chave para assinar os tokens JWT — gere uma string longa e aleatória
JWT_SECRET=troque-por-uma-string-bem-grande-e-aleatoria

# URL pública do frontend (usada nos links de e-mail e no CORS)
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# E-mail (opcional — pode configurar depois no painel)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Frontend ──
# URL pública da API (backend). Precisa terminar com /api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
