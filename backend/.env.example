# Banco de dados (Railway fornece esta URL automaticamente)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# JWT — troque por uma string longa e aleatória em produção
JWT_SECRET="troque-por-uma-string-segura-e-aleatoria"

# Servidor
PORT=3001
NODE_ENV=production

# URL pública do frontend (para os links de confirmação de presença)
APP_URL="https://seu-frontend.vercel.app"

# CORS — URLs permitidas (separadas por vírgula)
CORS_ORIGINS="https://seu-frontend.vercel.app"

# Upload de fotos
UPLOAD_DIR="uploads"

# E-mail fallback (opcional — use a config por pelada no painel)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
